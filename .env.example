# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Stream Emitter ───────────────────────────────────────────────────────────
EMITTER_TPS=100                        # Target transactions-per-second
EMITTER_FRAUD_RATE=0.02                # Fraction of transactions that are fraudulent
EMITTER_DATASET_PATH=data/raw/         # Path to Kaggle dataset CSV(s)

# ─── Graph Engine ─────────────────────────────────────────────────────────────
GRAPH_MAX_NODES=100000                 # Max accounts tracked in-memory
GRAPH_WINDOW_SECONDS=60               # Sliding time window for graph pattern analysis
GRAPH_FANOUT_THRESHOLD=5              # Min out-edges in T seconds to flag Fan-Out
GRAPH_FANIN_THRESHOLD=5               # Min in-edges in T seconds to flag Fan-In
GRAPH_SCATTER_GATHER_HOPS=3           # Max hops for Scatter-Gather detection
GRAPH_LATENCY_BUDGET_MS=200           # Hard SLA for pattern detection (ms)

# ─── Risk Scoring ─────────────────────────────────────────────────────────────
RISK_BLOCK_THRESHOLD=0.85             # Score >= this triggers BLOCK
RISK_FLAG_THRESHOLD=0.60              # Score >= this triggers FLAG (monitor)
RISK_MODEL_PATH=data/models/risk_scorer.pkl

# ─── WebSocket / API ──────────────────────────────────────────────────────────
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
WS_MAX_CONNECTIONS=50
WS_BROADCAST_INTERVAL_MS=100          # Push updates to dashboard every 100ms
